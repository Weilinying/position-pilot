# 仅供本地开发使用的示例值；请勿填入生产环境凭据。
POSTGRES_DB=position_pilot
POSTGRES_USER=position_pilot
POSTGRES_PASSWORD=position_pilot_dev_password

# 本地 Docker PostgreSQL 17 的 SQLAlchemy / psycopg 连接地址。
DATABASE_URL=postgresql+psycopg://position_pilot:position_pilot_dev_password@localhost:5432/position_pilot

# Alpaca Market Data API v2；请仅在本地 .env 填入真实凭据。
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
ALPACA_REQUEST_TIMEOUT_SECONDS=10

# M9 Asset Metadata Provider；用于按 symbol / company name 搜索与 exact validate。
FINNHUB_API_KEY=
FINNHUB_BASE_URL=https://finnhub.io/api/v1
FINNHUB_REQUEST_TIMEOUT_SECONDS=10

# V1 默认 LLM Provider；Model 可通过环境变量替换，不绑定业务层。
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4-pro-0813
LLM_REQUEST_TIMEOUT_SECONDS=30

# M9 Vision Provider；默认使用阿里云 Model Studio qwen3-vl-flash。
# 若 VISION_API_KEY 留空，Bootstrap 会复用 LLM_API_KEY；请勿把真实凭据提交到 Git。
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_API_KEY=
VISION_MODEL=qwen3-vl-flash
VISION_REQUEST_TIMEOUT_SECONDS=30
