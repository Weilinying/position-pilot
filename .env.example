# 仅供本地开发使用的示例值；请勿填入生产环境凭据。
POSTGRES_DB=position_pilot
POSTGRES_USER=position_pilot
POSTGRES_PASSWORD=position_pilot_dev_password

# 本地 Docker PostgreSQL 17 的 SQLAlchemy / psycopg 连接地址。
DATABASE_URL=postgresql+psycopg://position_pilot:position_pilot_dev_password@localhost:5432/position_pilot

# Alpaca Market Data API v2；请仅在本地 .env 填入真实凭据。
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
ALPACA_REQUEST_TIMEOUT_SECONDS=10

# M9 Asset Metadata Provider；用于按 symbol / company name 搜索与 exact validate。
FINNHUB_API_KEY=
FINNHUB_BASE_URL=https://finnhub.io/api/v1
FINNHUB_REQUEST_TIMEOUT_SECONDS=10

# 正式 Final 默认使用 Gemini 官方 API；Key 与 Aliyun Vision 完全独立。
LLM_PROVIDER=GOOGLE_GEMINI
LLM_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
# 以下兼容配置仅用于显式选择 Aliyun / OpenAI-compatible Final；Gemini 不读取它们。
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_REQUEST_TIMEOUT_SECONDS=30
# PydanticAI Production Native 路径独立上限；不改变旧 Runtime 的超时配置。
NATIVE_LLM_REQUEST_TIMEOUT_SECONDS=60

# OPEN_WEB_RESEARCH=DEFERRED；本分支没有 Search 装配或启用开关。
# 保留关闭值仅作意图声明，Settings 不消费该变量；设为 1 也不会暴露 web_research。
RESEARCH_ENABLED=0

# Phase 3 显式 Opt-in Spike；Brave 仅为实验候选，不是 Production Dependency。
RUN_PHASE3_LIVE=0
BRAVE_SEARCH_API_KEY=
SPIKE_DATABASE_URL=postgresql+psycopg://phase3_spike:phase3_spike_password@localhost:55432/position_pilot_phase3

# M9 Vision Provider；默认使用阿里云 Model Studio qwen3-vl-flash。
# Gemini Final 下必须独立配置 VISION_API_KEY，不使用 GEMINI_API_KEY 或 LLM_API_KEY。
# 只有显式选择 ALIYUN_MODEL_STUDIO Final 时，缺 Vision Key 才复用 LLM_API_KEY。
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_API_KEY=
VISION_MODEL=qwen3-vl-flash
VISION_REQUEST_TIMEOUT_SECONDS=30
